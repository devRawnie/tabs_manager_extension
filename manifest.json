{
  "manifest_version": 3,
  "name": "Tab Stash",
  "description": "Declutter your browser by organizing your tabs into collections for later use. Stay productive and keep your browser clean!",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://developer.chrome.com/*"],
  "permissions": [
    "tabs",
    "storage"
  ]
}
